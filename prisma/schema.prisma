datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ProcedureType {
  EU_EEA_EXCHANGE
  NON_EU_CONVERSION
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  AWAITING_DOCUMENTS
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum DocumentType {
  LICENSE_FRONT
  LICENSE_BACK
  ID_DOCUMENT
  PROOF_OF_ADDRESS
  SWORN_TRANSLATION
  OTHER
}

model LicenseExchangeRequest {
  id     String        @id @default(cuid())
  locale String
  status RequestStatus @default(SUBMITTED)

  // Identité & contact
  firstName          String
  lastName            String
  dateOfBirth         DateTime
  email               String
  phone               String
  addressLine1        String
  addressLine2        String?
  postalCode          String
  city                String
  countryOfResidence  String // ISO 3166-1 alpha-2

  // Permis actuel
  licenceIssuingCountry String // ISO 3166-1 alpha-2
  licenceNumber         String
  licenceIssueDate      DateTime
  licenceExpiryDate     DateTime?
  licenceCategories     String[]

  // Destination & procédure
  destinationCountry String // ISO 3166-1 alpha-2
  procedureType      ProcedureType

  consentAt     DateTime
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([status])
  @@index([email])
}

enum LicenceTiming {
  BEFORE_RESIDENCY
  AFTER_RESIDENCY
}

enum PreQualificationStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  CONTACTED
}

// Questionnaire de préqualification — première étape avant le dossier complet
// (LicenseExchangeRequest). Rempli en libre-service, revu manuellement par
// l'équipe qui décide de l'éligibilité avant d'inviter le client à déposer
// son dossier complet.
model PreQualification {
  id     String                 @id @default(cuid())
  locale String
  status PreQualificationStatus @default(PENDING)

  firstName String
  lastName  String
  email     String
  phone     String

  licenceIssuingCountry String // ISO 3166-1 alpha-2
  licenceStillValid     Boolean
  licenceCategories     String[]

  hasItalianResidency   Boolean
  italianResidencySince DateTime?

  licenceTiming LicenceTiming

  previousConversionAttempt Boolean
  previousConversionResult  String?

  licenceObtainedByExchange Boolean

  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

// Réglages du site éditables depuis le dashboard admin, une seule ligne
// ("singleton") pour l'ensemble du site, toutes locales confondues.
model SiteSettings {
  id             String   @id @default("singleton")
  contactEmail   String?
  contactPhone   String?
  contactAddress String?
  updatedAt      DateTime @updatedAt
}

model Document {
  id        String                  @id @default(cuid())
  request   LicenseExchangeRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  type      DocumentType

  // Cloudinary
  publicId String
  url      String
  format   String?
  fileName String

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ─── Auth (better-auth) — équipe interne uniquement, pas de compte client ────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
