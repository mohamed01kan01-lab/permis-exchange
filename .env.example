# Base de données (Prisma v7 + adapter-pg — Neon ou équivalent, comme sur nextpress)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary (upload des documents depuis le formulaire /demande)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Exposé au navigateur pour le widget d'upload next-cloudinary (preset non-signé)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Auth (dashboard admin) — génère un secret avec `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (email de notification à chaque nouvelle demande)
RESEND_API_KEY=""
RESEND_FROM="Permis-Exchange <notifications@tondomaine.com>"
ADMIN_NOTIFICATION_EMAIL=""
# Format international sans "+" ni espaces, ex: 393331234567
ADMIN_WHATSAPP_NUMBER=""
